# ======================================
# GROQ API Configuration
# ======================================
# Get your free API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional Groq settings
GROQ_MODEL=llama-3.1-8b-instant
MODEL_TEMPERATURE=0.7

# ======================================
# OpenAI API Configuration (Optional)
# ======================================
# Get your API key at: https://platform.openai.com/
# Uncomment and add your key to use OpenAI models
# OPENAI_API_KEY=your_openai_api_key_here

# ======================================
# Ollama Configuration (Optional - Local)
# ======================================
# Install Ollama from: https://ollama.ai/
# Then download models: ollama pull llama2
# Default URL (change if needed)
# OLLAMA_BASE_URL=http://localhost:11434

# ======================================
# System Prompt (Optional)
# ======================================
SYSTEM_PROMPT=You are a helpful and concise assistant.

# ======================================
# MarketAux Financial News API (Optional)
# ======================================
# Get your free API key at: https://www.marketaux.com/register
# Free tier: 50 requests/hour
# MARKETAUX_API_KEY=your_marketaux_api_key_here

# ======================================
# LangSmith Tracing (Optional)
# ======================================
# Get your API key at: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=content-generator

# ======================================
# LangSmith Tracing (Optional)
# ======================================
# Get your API key at: https://smith.langchain.com/
# Free tier available for development
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=content-generator
